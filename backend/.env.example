# supabase
SUPABASE_URL=
SUPABASE_KEY=

# cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLEF_MODEL=clef-flash

# groq
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# youtube data api（公開範囲の判定に使う）
YOUTUBE_API_KEY=

# Vercel の ORIGIN_SECRET と同じ値。空ならヘッダー確認をしない（ローカル用）
ORIGIN_SECRET=

# true のときだけのフィクスチャ（公開範囲の判定は 1〜3 秒、審査はルールごとに 0.5〜1.5 秒待機）:
# https://www.youtube.com/watch?v=SHORT-VIDEO  … Shorts（NO-SHORT fail → ポップアップ）
# https://www.youtube.com/watch?v=PRIVATE-VID  … private
debug=
