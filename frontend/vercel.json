{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"routes": [
		{
			"src": "/api/(.*)",
			"dest": "https://wildcard-check-api.onrender.com/api/$1",
			"transforms": [
				{
					"type": "request.headers",
					"op": "set",
					"target": {
						"key": "x-origin-secret"
					},
					"args": "$ORIGIN_SECRET",
					"env": ["ORIGIN_SECRET"]
				}
			]
		}
	]
}
